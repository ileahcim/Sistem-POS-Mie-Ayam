# Supabase project settings -> Database -> Connection string.
#
# DATABASE_URL: the POOLED connection (Supavisor/PgBouncer, transaction mode,
# port 6543). Used by the app at runtime (src/lib/prisma.ts) — safe for
# serverless functions that open many short-lived connections.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: the DIRECT connection (port 5432, no pooler). Used only by the
# Prisma CLI (migrate, db push, studio) — PgBouncer transaction mode can't
# run migration DDL reliably.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase project settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
