generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Staff
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  CASHIER
}

// Profile row linked to a Supabase Auth user (auth.users.id). Supabase owns
// credentials and the whole `auth` schema — Prisma only manages `public`,
// so there's no FK constraint to auth.users here, just the matching UUID.
// isActive (not a hard delete) because Order/Shift/Expense rows keep a
// permanent FK to whoever created them.
//
// Staff never see or type an email. `username` is what's shown and typed at
// login; the app maps it to a synthetic email (see src/lib/auth/username.ts)
// only to satisfy Supabase Auth's email/password API underneath.
model User {
  id          String  @id @default(cuid())
  authUserId  String  @unique @db.Uuid
  username    String  @unique
  name        String
  role        Role    @default(CASHIER)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  shiftsOpened    Shift[]     @relation("ShiftOpenedBy")
  shiftsClosed    Shift[]     @relation("ShiftClosedBy")
  expensesCreated Expense[]
  ordersCreated   Order[]     @relation("OrderCreatedBy")
  ordersVoided    Order[]     @relation("OrderVoidedBy")
  ordersCancelled Order[]     @relation("OrderCancelledBy")
  paymentMethodChangesMade PaymentMethodChange[] @relation("OrderPaymentMethodChangedBy")
  mieLedgerEntriesCreated MieLedgerEntry[]
  frozenLedgerEntriesCreated FrozenLedgerEntry[]
  depositEntriesCreated   PreorderDeposit[]
}

// ---------------------------------------------------------------------------
// Store settings — single-outlet warung, so this is a singleton row (fixed
// id) rather than a table keyed by outlet. Read at print time instead of
// hardcoding the store name/footer in code, and editable from the admin
// settings page (stage 5).
// ---------------------------------------------------------------------------

// "Perkiraan Bakso Terpakai" (Dashboard, CLAUDE.md, 24 Sep 2026) — informal
// ESTIMATE, not an inventory/stock system (no deduction, no low-stock
// alert). Editable from Manajemen Menu instead of hardcoded, because the
// owner's recipe can change; the aggregation itself still identifies WHICH
// order lines contribute by matching product/addon NAMES in code (same
// established pattern as NAMED_COMBOS / DELIVERY_CHARGEABLE_CATEGORY_NAME) —
// only the ball COUNTS below are data. Singleton row, same shape as Setting.
model BaksoUsageSetting {
  id String @id @default("singleton")

  // Product "Bakso" bowl, by which (if any) "Jenis Bakso" addon is chosen —
  // mutually exclusive, not additive (choosing Urat/Telur REPLACES some of
  // the plain balls with one bigger one, not adds on top).
  baksoPolosKecil Int @default(7)
  baksoUratKecil  Int @default(4)
  baksoUratUrat   Int @default(1)
  baksoTelurKecil Int @default(4)
  baksoTelurTelur Int @default(1)

  // "Tambah Bakso" addon group options, on Mie Ayam/Pangsit Rebus/Ceker —
  // always additive on top of the host product (which has 0 of its own).
  toppingBaksoKecil      Int @default(3)
  toppingBaksoUratUrat   Int @default(1)
  toppingBaksoTelurTelur Int @default(1)

  // Standalone bakso products (bijian / half-portion) — no addons involved.
  baksoKecilProdukKecil Int @default(3)
  baksoSetengahKecil    Int @default(4)
  baksoUratBijianUrat   Int @default(1)
  baksoTelurBijianTelur Int @default(1)

  updatedAt DateTime @updatedAt
}

model Setting {
  id            String  @id @default("singleton")
  storeName     String
  address       String?
  phone         String?
  receiptFooter String  @default("Terima kasih!")

  // Order Aktif timer: estimated prep time = prepBaseMinutes +
  // prepMinutesPerPortion * portions-needing-prep. Orange past estimate,
  // red past 2x estimate. Owner-tunable from the admin page (stage 11) —
  // never hardcoded in the timer component itself.
  prepBaseMinutes       Int @default(4)
  prepMinutesPerPortion Int @default(1)

  // On (default): receipt prints automatically right after payment, same
  // as before this setting existed. Off: the cashier is asked "Cetak
  // struk?" after Bayar — the transaction itself is always fully saved
  // either way; this only ever gates the PRINT action, never the payment.
  // Owner-tunable from /admin/settings — paper-saving toggle for customers
  // who don't need a receipt.
  autoPrintReceipt Boolean @default(true)

  // Blur part of the sheet/popup entrance animation (filter: blur is
  // GPU-heavy). Owner can switch it off from /admin/settings if it stutters
  // on the real tablet — the rest of the spring/stagger animation stays.
  // Devices with prefers-reduced-motion never get blur or movement at all.
  sheetBlurEnabled Boolean @default(true)

  // Active print driver. "webbluetooth" (Chrome on the POS tablet, no helper
  // app, no watermark — preferred for the Blueprint ECO80D) is the default;
  // switch to "rawbt" (Android RawBT app over Classic SPP) if Web Bluetooth
  // can't pair, or "mock" to preview the receipt on-screen instead of paper.
  // Owner-tunable from /admin/settings; lives on the singleton so the
  // server pages can hand the effective driver straight to the client
  // printer factory instead of the client guessing.
  printerDriver String @default("webbluetooth")

  // On (default): the store logo (public/assets/logo-ctr-thermal.png) is
  // rasterised into the struk/daftar packing header. Off: text-only header
  // for a leaner paper output. Owner-tunable from /admin/settings; the
  // "logonya pecah di printer" escape hatch without touching code.
  printLogo Boolean @default(true)

  // How long before a pre-order's scheduledFor the red reminder bar appears
  // on the Kasir screen. Minutes, not hours, so the owner can pick 30 menit
  // without the setting needing fractions; the UI offers presets rather than
  // a number field (see "Konteks pengguna" in CLAUDE.md).
  preorderReminderMinutes Int @default(120)

  // Off (default): the kitchen ticket feature does not exist at all — no
  // print prompt anywhere, same flow as before this feature. On: saving an
  // order and adding items to one both ask the cashier "Cetak kertas dapur?"
  // (never automatic — see CLAUDE.md "Kertas dapur"), and the manual "Cetak
  // Tiket Dapur" button appears on the order detail screen. Default OFF on
  // purpose: 22 Sep 2026 is the warung's first real operating day, and its
  // flow must stay byte-identical to what was already tested until the owner
  // switches this on themselves.
  kitchenTicketEnabled Boolean @default(false)

  // "Menu Populer" (Kasir shortcut row): how many times a product+add-on
  // combination must have sold in the last 30 days before it earns a
  // shortcut. Read by refreshComboCache at shift close (never live — the row
  // must not reshuffle mid-service). Owner-tunable from /admin/settings, so
  // it can start low while data is thin and go up once a month of sales
  // exists. Default 10 = the value this used to be hardcoded to.
  popularComboMinSales Int @default(10)

  // "Hitung kembalian" (26 Sep 2026): on = a full-Cash payment (and a cash
  // piutang settlement / cash DP) asks for "Uang diterima" and shows the
  // change. Record-keeping only — the drawer always counts the order total
  // (or its cash slice), never the money handed over.
  cashChangeEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Menu: category -> product -> addon groups -> addon options
// ---------------------------------------------------------------------------

model Category {
  id       String @id @default(cuid())
  name     String @unique
  sortOrder Int   @default(0)

  // Kulkas, Lain-lain, and Frozen items don't need prep and are excluded
  // from any kitchen-facing queue. Makanan and Minuman Racik do need prep.
  isKitchenItem Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
}

model Product {
  id         String  @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name      String
  price     Int // Rupiah, integer, never Float
  costPrice Int? // owner-entered estimate, snapshotted onto order items
  // Whether costPrice above is a confirmed number (from stated profit or a
  // real receipt) vs a back-of-envelope estimate — shown as a badge on the
  // HPP admin page (/admin/hpp) so the owner knows which numbers still need
  // confirming. Meaningless while costPrice is null.
  costPriceEstimated Boolean @default(false)
  // Owner-confirmed "yes, this margin is deliberately thin/negative" (e.g. a
  // loss-leader) — suppresses the low-margin warning on the HPP admin page
  // and the Dashboard Margin section for this item specifically.
  marginIntentional Boolean @default(false)
  imageUrl  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true) // soft delete only — old orders reference this row forever

  addonGroups ProductAddonGroup[]
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A group of add-on options, e.g. "Topping Mie" or "Jenis Bakso".
// minSelect/maxSelect drive both validation and the "Harus dipilih · Pilih 1"
// vs "Opsional" label in the UI — no separate "required" flag needed.
model AddonGroup {
  id        String @id @default(cuid())
  name      String @unique
  minSelect Int    @default(0)
  maxSelect Int? // null = unlimited (e.g. Topping Mie, Topping Bakso)

  options  AddonOption[]
  products ProductAddonGroup[]

  createdAt DateTime @default(now())
}

// Many-to-many: which addon groups attach to which products (e.g. "Topping
// Mie" attaches to Mie Ayam, Pangsit Rebus, and Ceker Rebus).
model ProductAddonGroup {
  id           String @id @default(cuid())
  productId    String
  addonGroupId String
  sortOrder    Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id])
  addonGroup AddonGroup @relation(fields: [addonGroupId], references: [id])

  @@unique([productId, addonGroupId])
}

model AddonOption {
  id           String  @id @default(cuid())
  addonGroupId String
  addonGroup   AddonGroup @relation(fields: [addonGroupId], references: [id])

  name      String
  price     Int     @default(0) // Rupiah delta, e.g. +5000
  costPrice Int?
  // Same two flags as Product above — see comments there.
  costPriceEstimated Boolean @default(false)
  marginIntentional Boolean @default(false)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true) // soft delete only

  orderItemAddons OrderItemAddon[]

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Shift & cash reconciliation
// ---------------------------------------------------------------------------

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id       String      @id @default(cuid())
  status   ShiftStatus @default(OPEN)

  openedById String
  openedBy   User   @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  openedAt   DateTime @default(now())
  openingCash Int // modal laci, differs every day

  // Per-shift queue number counter. Incremented atomically
  // (Shift.update({ data: { lastQueueNumber: { increment: 1 } } })) so two
  // devices can never hand out the same number for the same shift.
  lastQueueNumber Int @default(0)

  closedById String?
  closedBy   User?    @relation("ShiftClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime?

  // Frozen at close time. Never recomputed from live order data afterwards —
  // a later void must not change a shift report that's already closed.
  cashSales     Int?
  nonCashSales  Int?
  expenseTotal  Int?
  expectedCash  Int? // openingCash + cashSales - depositsAppliedCash + depositsReceivedCash - depositRefundsCash - expenseTotal
  countedCash   Int? // what the cashier physically counted, entered blind
  difference    Int? // countedCash - expectedCash, shown only after countedCash is submitted

  // Pre-order DP (uang muka), frozen at close like everything above. NULL on
  // every shift that closed before DP existed — those reports are never
  // recomputed, and NULL reads as 0 everywhere they are shown.
  //
  // cashSales/nonCashSales stay the FULL sale value recognised on the delivery
  // day (that is what omzet, margin and per-channel all read); these columns
  // only explain how the DRAWER differs from that number:
  //   depositsAppliedCash     DP (received on an earlier day) that was applied
  //                           to orders paid in CASH this shift. Those rupiah
  //                           are inside cashSales but never hit today's drawer.
  //   depositsReceivedCash    cash DP taken this shift. Physically in the
  //                           drawer, but not a sale (yet).
  //   depositsReceivedNonCash QRIS DP taken this shift. Informational — never
  //                           touches the drawer.
  //   depositRefundsCash      cash DP handed back this shift (cancelled
  //                           pre-order, or the customer overpaid). Leaves the
  //                           drawer.
  //   depositRefundsNonCash   the same for QRIS. Informational.
  //   forfeitedDeposits       "DP hangus": DP kept from a cancelled pre-order,
  //                           recognised as revenue on the day of cancellation.
  //                           Not a food sale, so it lives apart from cashSales.
  depositsAppliedCash     Int?
  depositsReceivedCash    Int?
  depositsReceivedNonCash Int?
  depositRefundsCash      Int?
  depositRefundsNonCash   Int?
  forfeitedDeposits       Int?

  // Piutang (RECEIVABLE) settled THIS shift — 25 Sep 2026. A piutang's sale
  // is recognised on the day it is actually paid, in the shift open at that
  // moment (Order.settledShiftId), never in the shift it was created in. Its
  // cash/QRIS portions are INSIDE cashSales/nonCashSales above (so omzet reads
  // them with no formula change); these only explain the drawer. NULL on every
  // shift closed before this existed = 0.
  //   receivableSettledCash     cash portion of piutang settled this shift
  //                             (laci AND kantong). Informational.
  //   receivableSettledNonCash  QRIS portion. Informational.
  //   receivablePocketCash      the cash the owner took straight into the
  //                             pocket ("masuk kantong") — recorded as a sale,
  //                             but never in the drawer, so subtracted from
  //                             expectedCash like depositsAppliedCash.
  receivableSettledCash    Int?
  receivableSettledNonCash Int?
  receivablePocketCash     Int?

  orders             Order[]
  settledReceivables Order[] @relation("OrderSettledShift")
  expenses Expense[]
  deposits PreorderDeposit[]
}

model Expense {
  id      String @id @default(cuid())
  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id])

  description String
  amount      Int // Rupiah

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum ChannelType {
  DINE_IN
  BUNGKUS
  ANTAR
}

enum OrderStatus {
  OPEN // unpaid, still editable
  PAID // frozen, no further edits
  VOID // cancelled, requires OWNER + reason
  RECEIVABLE // "piutang" — resolved at shift-close time without collecting cash
  // "Batal" — an unpaid (OPEN) order cancelled before any money moved
  // (wrong input, customer changed their mind). Deliberately separate from
  // VOID: any logged-in user (CASHIER too) may do it, reason still
  // required. See cancelOrder in order-aktif/actions.ts.
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  // "Cash + QRIS" — the customer's cash falls short, so part is tendered
  // cash and the rest QRIS, in ONE payment (CLAUDE.md-worthy brief, 22 Sep
  // 2026). Order.splitCashAmount/splitQrisAmount below carry the split;
  // every other PaymentMethod leaves both null.
  SPLIT
}

model Order {
  id      String  @id @default(cuid())

  // Nullable specifically for pre-orders: a pre-order is created with no
  // shift at all (taken over WhatsApp while the warung is closed, no open
  // shift to attach to) and stays that way until it's actually paid — see
  // CLAUDE.md "Pre-order". Every regular walk-in order still gets shiftId
  // set immediately at creation, same as before.
  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  // Set only when a RECEIVABLE (piutang) order is settled — the shift open at
  // that moment, which is where its sale and drawer effect are counted
  // (closeShift / shift-math.ts), not `shiftId` (the shift it was created in,
  // which keeps its queue number). settlementCashToDrawer: for a cash-like
  // settlement, true = the cash went into the drawer ("masuk laci"), false =
  // straight into the owner's pocket ("masuk kantong", recorded only). Null
  // for a QRIS settlement and for every ordinary order.
  settledShiftId         String?
  settledShift           Shift?   @relation("OrderSettledShift", fields: [settledShiftId], references: [id])
  settlementCashToDrawer Boolean?

  // Persistent, never resets — the receipt's own reference number.
  // Distinct from queueNumber below (Postgres autoincrement already gives
  // us atomicity across concurrent devices for free, no manual counter needed).
  orderNumber Int @unique @default(autoincrement())

  // Server-generated, resets per shift. Identity for the Order Aktif screen.
  // Not shown to the customer when the order is first created (no ticket at
  // that point) — only printed later on the payment receipt, alongside
  // orderNumber. Null until a shift is attached — for a pre-order that's not
  // until payment, same moment as shiftId (see CLAUDE.md "Pre-order").
  queueNumber Int?

  // "" for a normal order. "A"/"B"/... for a child created by "Pisahkan &
  // Bayar" (see splitAndPay in order-aktif/actions.ts) — it shares its
  // parent's queueNumber (shown as "#18-A") but is otherwise a completely
  // normal, independently payable Order row with its own orderNumber. Never
  // null (unlike queueNumber) specifically so it can sit in the unique
  // constraint below without Postgres's NULL-is-never-equal-to-NULL rule
  // silently letting two plain orders share a queueNumber.
  queueSuffix String @default("")

  channel    ChannelType
  tableLabel String? // one of K1, K2, L1, L2, L3 — validated in app code, not DB-level

  // Optional — a name to call out or write on packaging. Free text on
  // purpose (not tied to tableLabel): "Budi", "meja 3", whatever the
  // cashier finds useful. Required (enforced in app code) when a shift
  // close marks this order RECEIVABLE, so there's something to collect
  // against later.
  customerName String?

  status OrderStatus @default(OPEN)

  // Food-ready and payment are independent axes — see servedAt vs paidAt.
  servedAt DateTime?

  paymentMethod PaymentMethod?
  paidAt        DateTime?
  cashTendered  Int? // only set when the cashier used a quick cash-denomination button
  changeGiven   Int?
  // Split payment breakdown — set together, only when paymentMethod is
  // SPLIT. They sum to whatever was actually collected THIS payment: the
  // full total normally, or just the remainder when a DP already covered
  // part of it (CLAUDE.md-worthy brief, 22 Sep 2026). Both null otherwise.
  splitCashAmount Int?
  splitQrisAmount Int?

  // Pre-order: hidden from Order Aktif until this time arrives, shown under
  // "Pesanan Terjadwal" until then.
  scheduledFor DateTime?

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  voidReason String?
  voidedById String?
  voidedBy   User?   @relation("OrderVoidedBy", fields: [voidedById], references: [id])
  voidedAt   DateTime?

  // Set only for status CANCELLED — kept apart from the void* columns
  // above on purpose so a "Batal" (cashier, unpaid) is never mistaken for a
  // "Void" (OWNER) when tracing history.
  cancelReason  String?
  cancelledById String?
  cancelledBy   User?     @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?

  items    OrderItem[]
  deposits PreorderDeposit[]
  paymentMethodChanges PaymentMethodChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shiftId, queueNumber, queueSuffix])
}

// A correction to an already-PAID order's payment method — e.g. Cash tapped
// by mistake instead of QRIS (CLAUDE.md "Ubah Metode Bayar", 24 Sep 2026).
// Void doesn't fit this: the sale itself was correct, only the method was
// mistyped, and voiding + re-ordering would burn a fresh queue number and
// split one real event into two history rows. Append-only log (own table,
// not columns on Order like void*/cancel*) because — unlike Void, which can
// only ever happen once — a payment method could in principle be corrected
// more than once, and every correction must stay visible, not just the
// latest one. *CashAmount/*QrisAmount are only ever set alongside a SPLIT
// method, mirroring Order.splitCashAmount/splitQrisAmount.
model PaymentMethodChange {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  fromMethod     PaymentMethod
  fromCashAmount Int?
  fromQrisAmount Int?
  toMethod       PaymentMethod
  toCashAmount   Int?
  toQrisAmount   Int?

  reason String

  changedById String
  changedBy   User     @relation("OrderPaymentMethodChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([orderId])
}

// What happened to a slice of a pre-order's DP (uang muka).
enum DepositKind {
  RECEIVED // the customer handed over DP
  APPLIED // DP offset against the final sale when the order is paid
  REFUNDED // DP handed back: pre-order cancelled, or the customer overpaid
  FORFEITED // pre-order cancelled and the DP kept — "DP hangus"
}

// DP ledger. Like MieLedgerEntry: the balance a pre-order still holds is
// never a stored column, it is RECEIVED minus everything that settled it, and
// nothing here is ever edited or deleted — a correction is a new row.
// `amount` is always positive; `kind` says which way it went.
//
// Why a table and not a column on Order: a customer can pay DP more than once,
// and every entry has its own day, method and shift — the shift is what lets
// a cash DP be part of THAT day's drawer reconciliation, as a receipt and not
// as a sale (see Shift.depositsReceivedCash).
model PreorderDeposit {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  kind   DepositKind
  method PaymentMethod // CASH or QRIS only — enforced in app code, TRANSFER is legacy
  amount Int // Rupiah, > 0
  // A RECEIVED cash DP taken with "Hitung kembalian" on: what the customer
  // handed over and the change given back. Notes only — the drawer counts
  // `amount`. Null otherwise (and on every row from before 26 Sep 2026).
  cashTendered Int?
  changeGiven  Int?

  // The shift that was open when this happened. Always set for anything that
  // moves cash (a cash DP or refund needs an open shift). Null only for a
  // QRIS RECEIVED/REFUNDED entry made while no shift was open.
  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  // Cancellation reason for REFUNDED/FORFEITED entries made by cancelling.
  note String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([shiftId])
}

// One row per distinct cart line. Product name/price/cost are snapshotted at
// add-to-cart time so a later price change or product edit never touches
// historical orders — nothing here is ever joined back to Product for money.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  // Null for a custom item ("+ Item Custom" — free name/price typed by the
  // cashier, no real Product behind it, CLAUDE.md-worthy brief 22 Sep 2026).
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  productName String // snapshot (typed by the cashier for a custom item)
  unitPrice   Int // snapshot of Product.price
  costPrice   Int? // snapshot of Product.costPrice
  qty         Int    @default(1)
  notes       String? // "Catatan · Opsional" free text

  // Snapshot of whether this product's category counted toward Antar
  // delivery fee at the time it was ordered (category could change later).
  isDeliveryChargeable Boolean @default(false)

  // Snapshot of Category.isKitchenItem — Makanan and Minuman Racik need
  // prep, Kulkas/Lain-lain/Frozen don't. Drives the Order Aktif prep-time
  // estimate (portions needing prep, not total portions).
  isKitchenItem Boolean @default(true)

  // Sorted fingerprint of productId + addon option ids, e.g. "p1-a3_a5_a7".
  // Written once at creation; powers the 30-day popular-combo aggregation
  // without joining/comparing addon sets at query time.
  comboKey String?

  // (unitPrice + sum(addon prices)) * qty — snapshotted, not recomputed.
  lineTotal Int

  addons OrderItemAddon[]

  createdAt DateTime @default(now())
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  addonOptionId String
  addonOption   AddonOption @relation(fields: [addonOptionId], references: [id])

  name      String // snapshot
  price     Int // snapshot
  costPrice Int? // snapshot
}

// ---------------------------------------------------------------------------
// Popular combo shortcuts (rolling 30-day cache, refreshed once daily at
// shift close — never computed on demand while the cashier screen is open)
// ---------------------------------------------------------------------------

model ComboCache {
  id          String @id @default(cuid())
  comboKey    String @unique

  displayName   String
  totalPrice    Int
  salesCount30d Int

  // [{ productId, name, qty, addons: [{ addonOptionId, name }] }]
  items Json

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Catatan Mi Mentah — raw noodle production sales ledger. Fully separate
// from the POS/cashier: money here never touches Shift/Expense/Order or any
// omzet number the POS side computes. OWNER only. See CLAUDE.md "Catatan Mi
// Mentah" for the full brief this was built from.
// ---------------------------------------------------------------------------

enum MieProductType {
  MIE_KERITING
  MIE_LURUS
  PANGSIT
  // RETIRED 22 Sep 2026 — a one-night experiment that put Frozen debt inside
  // the raw-noodle ledger as a "jenis". Wrong model: Frozen is consigned to
  // a reseller and settled separately from mi mentah (see FrozenCustomer/
  // FrozenLedgerEntry below, its own buku). Existing FROZEN-tagged rows
  // (including customer "KMK Frozen") are still HERE, pending the owner's
  // approval to move them — see the migration preview in the "Buku Frozen"
  // brief. This label is kept only because Postgres can't cleanly drop an
  // enum value without rewriting the column — app code never writes a new
  // one (MieProductType the TS type excludes it); src/lib/mie/types.ts
  // renders any remaining legacy row via LEGACY_FROZEN_LABEL.
  FROZEN
  CUSTOM
}

enum MieLedgerKind {
  ORDER
  PAYMENT
  OPENING_BALANCE
  // Manual balance fixes added later from the customer page (forgot to
  // record something, an old bookkeeping mistake) — always a NEW row, never
  // an edit of an old one, so the trail stays. Amount is still stored
  // positive; the kind carries the sign (ADD raises the debt, SUBTRACT
  // lowers it).
  CORRECTION_ADD
  CORRECTION_SUBTRACT
}

model MieCustomer {
  id       String  @id @default(cuid())
  name     String
  note     String? // free text — useful for telling two "Budi"s apart
  isActive Boolean @default(true) // soft delete, same convention as Product/AddonOption

  createdAt DateTime @default(now())

  entries MieLedgerEntry[]
}

// One editable default Rp/kg per fixed product — the starting suggestion
// before any customer-specific history exists (see MieLedgerEntry's price
// autofill rule below). Null until the owner sets it (never guessed/seeded
// — same "don't invent a money number" rule as Product.costPrice). No row
// for CUSTOM: a one-off request is priced fresh every time, never remembered.
model MieProductDefault {
  productType       MieProductType @id
  defaultPricePerKg Int?
  // Modal per kg bahan baku (Reguler) — owner-set from /note/produk, null =
  // "belum diisi". Unlike the sale price (snapshotted per ledger row, and
  // different per customer) this is ONE number per jenis that rarely
  // changes, so it is read live, never snapshotted: Ringkasan's margin for
  // every ORDER row is (amount − costPerKg × kg). A row whose jenis has no
  // cost is left OUT of the margin (with a warning), never counted as cost 0.
  costPerKg Int?
}

// Singleton for the Note module's own tunables (kept apart from the POS
// Setting table — Note is a separate world, see CLAUDE.md). pasarPricePerKg
// is the "Mie Pasar" shortcut price (Mi Keriting) on the new-order form —
// market prices change often, so it's owner-editable from /note/produk,
// never a code constant. Null = shortcut shown as "belum diisi".
model MieSetting {
  id              String @id @default("singleton")
  pasarPricePerKg Int?
  // Frozen buku's default Rp/pcs (owner-editable from /note/produk, same
  // page as the mi-mentah defaults) — starting suggestion before a customer
  // has any pickup history of their own (see FrozenLedgerEntry's price
  // autofill rule). Seeded 9000 by migration 20260923..._frozen_buku; never
  // guessed after that, same "don't invent a money number" rule as everywhere
  // else in this module.
  frozenPricePerPcs Int?
  // Modal per kg for "Mi Pasar" orders (MieLedgerEntry.isPasar) — a
  // different recipe (less egg) than Reguler Mi Keriting, so a different
  // cost, not just a different sale price. Mi Keriting only: Lurus/Pangsit
  // have no pasar variant. Null = "belum diisi", same rule as costPerKg.
  pasarCostPerKg Int?
}

// ---------------------------------------------------------------------------
// Buku Frozen — Mie Frozen consigned to a reseller (e.g. "KMK Frozen"): they
// sell it on and settle with the owner later, in cash straight to the owner.
// NOT the warung's cash drawer, NOT mi mentah — a third, fully separate
// ledger world living in the same Note module (CLAUDE.md-worthy brief, 22
// Sep 2026). Mirrors MieCustomer/MieLedgerEntry's shape exactly (balance is
// always a sum over rows, corrections are new rows, soft delete only) but
// priced per PIECE (pcs), not per kg, and with no "jenis" at all — every
// pickup is the same product.
// ---------------------------------------------------------------------------

// Metode bayar untuk baris PAYMENT di buku Note — dipakai BERSAMA oleh
// MieLedgerEntry dan FrozenLedgerEntry: satu konsep yang sama, jadi satu
// enum, bukan dua yang kembar. Sengaja terpisah dari PaymentMethod milik
// POS (yang punya TRANSFER/SPLIT dan ikut rekonsiliasi laci) — uang Note
// tidak pernah menyentuh laci warung, kolom ini murni pencatatan.
enum NotePaymentMethod {
  CASH
  QRIS
}

enum FrozenLedgerKind {
  ORDER // "Pengambilan" — pcs taken, priced per pcs
  PAYMENT
  OPENING_BALANCE
  CORRECTION_ADD
  CORRECTION_SUBTRACT
}

model FrozenCustomer {
  id       String  @id @default(cuid())
  name     String
  note     String?
  isActive Boolean @default(true) // soft delete, same convention as MieCustomer

  createdAt DateTime @default(now())

  entries FrozenLedgerEntry[]
}

// One unified ledger, exactly like MieLedgerEntry — balance is never a
// stored column, always the sum of signed amounts over these rows (see
// frozenEntrySignedAmount in lib/frozen/types.ts).
model FrozenLedgerEntry {
  id         String         @id @default(cuid())
  customerId String
  customer   FrozenCustomer @relation(fields: [customerId], references: [id])

  kind FrozenLedgerKind

  // ORDER-only fields — null for PAYMENT/OPENING_BALANCE/CORRECTION_*.
  pcs         Int?
  pricePerPcs Int? // snapshot at pickup time — never re-read from MieSetting later

  amount Int // Rupiah, always positive — see `kind` comment on MieLedgerEntry for the sign convention

  // PAYMENT-only, and nullable on purpose — see MieLedgerEntry.paymentMethod.
  paymentMethod NotePaymentMethod?

  date DateTime // business date — owner-settable, defaults to today
  note String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// A single unified ledger, not separate Order/Payment tables — the
// customer detail page's "riwayat lengkap ... dengan kolom saldo berjalan"
// reads naturally as ONE chronological list, and it's the only way to
// honor the hard rule that balance is ALWAYS a sum over rows, never a
// stored number: ORDER and OPENING_BALANCE add to the balance, PAYMENT
// subtracts — `amount` itself is always stored positive, the sign is
// applied by `kind` wherever balance is computed (see get-mie-customers.ts).
model MieLedgerEntry {
  id         String      @id @default(cuid())
  customerId String
  customer   MieCustomer @relation(fields: [customerId], references: [id])

  kind MieLedgerKind

  // ORDER-only fields — null for PAYMENT/OPENING_BALANCE.
  productType MieProductType?
  customLabel String? // filled only when productType == CUSTOM
  kg          Float?
  pricePerKg  Int? // snapshot at order time — never re-read from MieProductDefault later
  // ORDER only: tapped as "Mi Pasar" on the order form (always MIE_KERITING).
  // Picks which modal per kg the margin uses (MieSetting.pasarCostPerKg vs
  // MieProductDefault.costPerKg). Rows before 25 Sep 2026 were backfilled by
  // migration 20260925100000_mie_cost_per_kg from an owner-checked list.
  isPasar     Boolean @default(false)

  amount Int // Rupiah, always positive — see `kind` comment above for sign

  // PAYMENT-only. NULL means "tidak dicatat", which is a real, permanent
  // state for every payment recorded before 23 Sep 2026 — the column was
  // added nullable precisely so those rows are never guessed at. Required
  // for NEW payments (enforced in the server actions, not by the DB, so the
  // old rows stay valid). Owner can fill an old row in later from the edit
  // sheet if they still remember; an already-set method can be switched
  // between Cash and QRIS but never cleared back to unknown.
  paymentMethod NotePaymentMethod?

  date DateTime // business date — owner-settable, defaults to today (not necessarily createdAt)
  note String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}
